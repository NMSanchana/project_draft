{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API for End-to-End Business Insight Platform",
  "main": "dist/server.js",
  "scripts": {
    "start:dev": "nest start --watch",
    "dev": "nest start --watch",
    "dev:express": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "nest build",
    "build:express": "tsc",
    "build:nest": "nest build",
    "start": "node dist/main.js",
