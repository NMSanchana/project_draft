# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Placeholder - do not commit real credentials)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>

# JWT Authentication Secret (Placeholder - generate secure random string)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1d

# Google OAuth Client ID (Optional for verified Google Sign-In)
GOOGLE_CLIENT_ID=your_google_client_id_here
