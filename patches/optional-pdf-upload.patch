+export interface DocumentUploadResult {
+  id: string;
+  fileName: string;
+  chunks: number;
+  status: 'ingested' | 'duplicate';
+}
+
+/** Upload a PDF/TXT/MD for document Q&A (private to the signed-in user). */
+export async function uploadDocument(file: File): Promise<DocumentUploadResult> {
+  const form = new FormData();
+  form.append('file', file);
+  form.append('scope', 'user');
+  const res = await fetchWithAuth('/ai/v1/rag/documents', { method: 'POST', body: form });
+  return res.json();
+}
+
 export async function getDataset(datasetId: string): Promise<ProcessedAnalytics> {
   const res = await fetchWithAuth(`/ai/v1/datasets/${encodeURIComponent(datasetId)}`);
   return res.json();
